# Nie instaluj automatycznie zależności typu "peer".
# Nunjucks deklaruje opcjonalny peer chokidar@3 (z fsevents tylko dla macOS). npm 11 zapisuje go
# w package-lock.json jako "extraneous" bez flagi "optional", przez co `npm ci` na npm 10 (CI, Linux)
# kończy się błędem EBADPLATFORM. Eleventy ma własnego chokidara, więc ten peer nie jest potrzebny.
legacy-peer-deps=true
