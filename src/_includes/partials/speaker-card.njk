                <article class="speaker-card{% if speaker.rank %} speaker-card-top speaker-card-rank-{{ speaker.rank }}{% endif %}" id="{{ speaker.id }}">
                  <div class="speaker-card-media">
                    <img class="speaker-card-photo" src="../static/speakers/{{ speaker.photo }}" width="300" height="300" alt="Zdjęcie: {{ speaker.name }}" loading="lazy" decoding="async">
                    {%- if speaker.rank %}
                    <span class="speaker-rank" aria-label="Miejsce {{ speaker.rank }}">{{ speaker.rank }}</span>
                    {%- endif %}
                  </div>
                  <div class="speaker-card-body">
                    <h3>{{ speaker.name }}</h3>
                    <p class="speaker-card-stats"><span class="speaker-badge">{{ speaker.talkCount | talksLabel }}</span>
                    {%- if speaker.recordings > 0 %} <span class="speaker-badge speaker-badge-muted">{{ speaker.recordings | recordingsLabel }}</span>{% endif %}
                    {%- if speaker.rank %} <span class="speaker-badge speaker-badge-muted">debiut: #{{ speaker.first.meeting.number }}</span>{% endif %}</p>
                    <ul class="speaker-talks">
                    {%- for talk in speaker.talks %}
                      <li>
                        <a href="../spotkania/{{ talk.meeting.url }}"><span class="meeting-number">#{{ talk.meeting.number }}</span> {{ talk.title }}</a>
                        <small><time datetime="{{ talk.meeting.day }}">{{ talk.meeting.dateLabel }}</time>
                        {%- if talk.coSpeakers | length %} · razem z: {{ talk.coSpeakers | join(", ") }}{% endif %}
                        {%- if talk.recordingUrl %} · <a href="{{ talk.recordingUrl }}" target="_blank" rel="noopener noreferrer">nagranie <span aria-hidden="true">↗</span></a>{% endif %}</small>
                      </li>
                    {%- endfor %}
                    </ul>
                    <details class="speaker-bio">
                      <summary>O prelegencie</summary>
                      <p>{{ speaker.bio }}</p>
                    </details>
                  </div>
                </article>
{#- Karta prelegenta. Wymaga zmiennej `speaker`; `speaker.rank` (1–3) włącza wariant TOP 3. #}
