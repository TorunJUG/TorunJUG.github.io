{% extends "layouts/base.njk" %}
{#- Spotkania w karuzeli i liczniki wyliczane z data/meetings. -#}
{%- set recentMeetings = meetings.slice(0, site.homepageMeetings) %}
{%- set meetingsCount = meetings[0].number | floorTo(10) %}

{% block head %}
    <meta name="color-scheme" content="light">

    <title>Toruń JUG – społeczność Java i JVM w Toruniu</title>
