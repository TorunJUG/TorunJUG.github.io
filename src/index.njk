{% block main %}
    <main id="main-content">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src="./static/media/cover.jpg"
          width="2500"
          height="1667"
          alt="Uczestnicy spotkania Toruń Java User Group w sali wykładowej"
          fetchpriority="high"
          decoding="async"
        >
        <div class="hero-overlay" aria-hidden="true"></div>

        <div class="container hero-content">
          <p class="eyebrow eyebrow-light">Java User Group <span>•</span> Toruń</p>
          <h1 id="hero-title">Toruń JUG — społeczność Java i JVM w Toruniu</h1>
          <p class="hero-tagline">Przyjdź i opowiedz nam swoją historię!</p>
          <p class="hero-description">
            Spotykamy się cyklicznie w ostatnią środę miesiąca w godzinach
            18:00–20:00 na Wydziale Fizyki, Astronomii i Informatyki Stosowanej UMK
            w Toruniu przy ulicy Grudziądzkiej 5/7.
          </p>

          <div class="hero-actions">
            <a
              class="button button-accent"
              href="https://www.meetup.com/Torun-JUG/events/"
              target="_blank"
              rel="noopener noreferrer"
            >Zobacz najbliższe spotkanie <span aria-hidden="true">↗</span></a>
            <a
              class="button button-ghost"
              href="https://pawelkapala1.typeform.com/to/jvIxOo"
              target="_blank"
              rel="noopener noreferrer"
            >Zgłoś swoją prezentację</a>
          </div>

          <ul class="meeting-facts" aria-label="Najważniejsze informacje o spotkaniach">
            <li><a href="https://www.google.com/maps/d/u/3/edit?mid=1WkJL4Sp4pcMo3QOEnf15jLLcWqFVDwk&usp=sharing" target="_blank" rel="noopener noreferrer"><strong>Ⓟ Parkingi w okolicy</strong></a></li>
            <li><strong>Lokalizacja</strong><span>
              <a href="https://maps.app.goo.gl/uega7NYATYoPxaQR9" target="_blank" rel="noopener noreferrer">WFAiIS UMK ul. Grudziądzka 5/7 </a>
            </br>Na miejscu podążaj za znakami</span></li>
          </ul>
        </div>
      </section>

      <section class="section section-theme-light section-about" id="o-nas" aria-labelledby="about-title">
        <div class="container">
          <div class="section-heading section-heading-centered">
            <p class="eyebrow">Lokalna społeczność Java</p>
            <h2 id="about-title">Kim jesteśmy?</h2>
            <p class="section-lead">
              Toruń JUG (Java User Group) zrzesza pasjonatów technologii opartych o Java
              Virtual Machine, dla których programowanie to nie tylko praca, ale przede
              wszystkim hobby i dobra zabawa. Chcemy stale rozwijać naszą wiedzę i
              umiejętności programistyczne, a także zacieśniać więzy naszej lokalnej
              społeczności. W tym celu organizujemy cykliczne spotkania.
            </p>
          </div>

          <div class="values-grid">
            <article class="value-card">
              <span class="card-number" aria-hidden="true">01</span>
              <h3>Społeczność</h3>
              <p>
                Przyjdź pół godziny wcześniej i poznaj nas. Otwieramy salę wcześniej przed
                każdą prelekcją, żeby zachęcić do networkingu!
              </p>
            </article>

            <article class="value-card">
              <span class="card-number" aria-hidden="true">02</span>
              <h3>Edukacja</h3>
              <p>
                Tematyka oscyluje wokół JVM, ale nie unikamy żadnego tematu przydatnemu
                programiście. Każde spotkanie jest nagrywane i publikowane na naszym kanale
                YouTube.
              </p>
            </article>

            <article class="value-card">
              <span class="card-number" aria-hidden="true">03</span>
              <h3>Dobra zabawa</h3>
              <p>Po każdej prezentacji spotykamy się na afterparty.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section section-theme-dark section-stats" aria-labelledby="stats-title">
        <div class="container">
          <div class="section-heading section-heading-centered">
            <p class="eyebrow">Toruń JUG w liczbach</p>
            <h2 id="stats-title">Razem tworzymy społeczność</h2>
          </div>

          <dl class="stats-grid">
            <div class="stat-item">
              <dt>Lat działalności</dt>
              <dd>
                <span class="stat-value" data-counter="12" aria-hidden="true">12</span><span class="stat-plus" aria-hidden="true">+</span>
                <span class="visually-hidden">Ponad 12 lat działalności</span>
              </dd>
            </div>

            <div class="stat-item">
              <dt>Prelegentów</dt>
              <dd>
                <span class="stat-value" data-counter="150" aria-hidden="true">150</span><span class="stat-plus" aria-hidden="true">+</span>
                <span class="visually-hidden">Ponad 150 prelegentów</span>
              </dd>
            </div>

            <div class="stat-item">
              <dt>Spotkań</dt>
              <dd>
                <span class="stat-value" data-counter="{{ meetingsCount }}" aria-hidden="true">{{ meetingsCount }}</span><span class="stat-plus" aria-hidden="true">+</span>
                <span class="visually-hidden">Ponad {{ meetingsCount }} spotkań</span>
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section section-theme-light section-meetings" id="spotkania" aria-labelledby="meetings-title">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Przeżyj to jeszcze raz</p>
            <h2 id="meetings-title">Ostatnie spotkania</h2>
            <p class="section-lead">
              Jeśli przegapiłeś nasze spotkanie, nic straconego! Nagrania z prelekcji publikujemy na naszym kanale YouTube.
            </p>

            <p class="meetings-source">
            Pełne archiwum wydarzeń znajdziesz na
            <a href="https://www.meetup.com/pl-PL/torun-jug/events/?type=past" target="_blank" rel="noopener noreferrer">Meetup <span aria-hidden="true">↗</span></a>.
            </p>
          </div>

          <div class="meetings-carousel" data-meetings-carousel>
            <div
              class="meetings-carousel-viewport"
              data-meetings-viewport
              tabindex="0"
              aria-label="Ostatnie spotkania. Przewiń poziomo, aby zobaczyć kolejne."
            >
              <ol class="meetings-list" reversed start="{{ meetings[0].number }}">
              {%- set meetingsBase = "spotkania/" %}
              {%- for meeting in recentMeetings %}
            <li>
{% include "partials/meeting-card.njk" %}
            </li>
              {%- endfor %}
            <li>
              <a class="meeting-card meeting-card-archive" href="spotkania/index.html">
                <span class="meeting-archive-label">Pełne archiwum</span>
                <h3>Zobacz wszystkie spotkania Toruń JUG</h3>
                <p>Wróć do starszych prelekcji, tematów i nagrań naszej społeczności.</p>
                <span class="meeting-archive-action">Przejdź do listy <span aria-hidden="true">→</span></span>
              </a>
            </li>
              </ol>
            </div>

            <div class="meetings-carousel-controls" aria-label="Sterowanie karuzelą spotkań">
              <button
                class="carousel-button"
                type="button"
                data-carousel-previous
                aria-label="Pokaż nowsze spotkanie"
              ><span aria-hidden="true">←</span></button>

              <label class="carousel-progress">
                <span class="visually-hidden">Pozycja w karuzeli spotkań</span>
                <input
                  type="range"
                  min="0"
                  max="{{ recentMeetings | length }}"
                  value="0"
                  step="1"
                  data-carousel-progress
                  aria-label="Pozycja w karuzeli spotkań"
                >
              </label>

              <span class="carousel-position" data-carousel-position aria-live="polite">1 z {{ (recentMeetings | length) + 1 }}</span>

              <button
                class="carousel-button"
                type="button"
                data-carousel-next
                aria-label="Pokaż starsze spotkanie"
              ><span aria-hidden="true">→</span></button>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-theme-dark section-events" id="wydarzenia" aria-labelledby="events-title">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Więcej niż comiesięczne spotkania</p>
            <h2 id="events-title">Nasze wydarzenia</h2>
            <p class="section-lead">
              Toruń JUG Day jedyne w swoim rodzaju całodniowe spotkania z dodatkową dawką integracji a nawet muzyki na żywo.
            </p>
          </div>

          <div class="events-grid">

            <article class="event-card">
              <a href="wydarzenia/torun-jug-day-2024.html" aria-label="Zobacz szczegóły Toruń JUG Day 2024">
                <div class="event-card-media event-card-media-poster">
                  <img
                    src="./static/media/torun-jug-day-2024_comp.jpeg"
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                    alt="Plakat Toruń JUG Day 2024 z prelegentami wydarzenia"
                  >
                </div>
                <div class="event-card-content">
                  <div class="event-card-meta">
                    <time datetime="2024-05-18">18 maja 2024</time>
                    <span>Toruński Inkubator Technologiczny</span>
                  </div>
                  <h3>Toruń JUG Day 2024</h3>
                  <p>Cztery prelekcje, dziesięciolecie Toruń JUG i koncert Code Life Crisis.</p>
                  <span class="event-card-action">Poznaj wydarzenie <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </article>

            <article class="event-card">
              <a href="wydarzenia/torun-jug-day-2017.html" aria-label="Zobacz szczegóły Toruń JUG Day 2017">
                <div class="event-card-media">
                  <img
                    src="./static/media/cover-jugday-2_comp.jpeg"
                    width="1471"
                    height="932"
                    loading="lazy"
                    decoding="async"
                    alt="Uczestnicy Toruń JUG Day 2017 z Venkatem Subramaniamem"
                  >
                </div>
                <div class="event-card-content">
                  <div class="event-card-meta">
                    <time datetime="2017-06-24">24 czerwca 2017</time>
                    <span>Business Link Toruń</span>
                  </div>
                  <h3>Toruń JUG Day 2017</h3>
                  <p>Całodniowe spotkanie z gościem specjalnym Venkatem Subramaniamem.</p>
                  <span class="event-card-action">Poznaj wydarzenie <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </article>
          </div>
        </div>
      </section>

      <section class="section section-theme-light section-leaders" id="liderzy" aria-labelledby="leaders-title">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Poznaj organizatorów</p>
            <h2 id="leaders-title">Liderzy</h2>
          </div>

          <div class="leaders-grid">
            <article class="leader-card">
              <div class="leader-intro">
                <img
                  src="./static/media/sawicki-lukasz2.jpg"
                  width="440"
                  height="440"
                  loading="lazy"
                  decoding="async"
                  alt="Łukasz Sawicki"
                >
                <div>
                  <h3>Łukasz Sawicki</h3>
                  <nav class="leader-socials" aria-label="Media społecznościowe Łukasza Sawickiego">
                    <a href="https://pl.linkedin.com/in/%C5%82ukasz-sawicki-4bb4512" target="_blank" rel="noopener noreferrer" aria-label="Łukasz Sawicki na LinkedIn" title="LinkedIn">
                      <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
                        <path d="M26.111,3H5.889c-1.595,0-2.889,1.293-2.889,2.889V26.111c0,1.595,1.293,2.889,2.889,2.889H26.111c1.595,0,2.889-1.293,2.889-2.889V5.889c0-1.595-1.293-2.889-2.889-2.889ZM10.861,25.389h-3.877V12.87h3.877v12.519Zm-1.957-14.158c-1.267,0-2.293-1.034-2.293-2.31s1.026-2.31,2.293-2.31,2.292,1.034,2.292,2.31-1.026,2.31-2.292,2.31Zm16.485,14.158h-3.858v-6.571c0-1.802-.685-2.809-2.111-2.809-1.551,0-2.362,1.048-2.362,2.809v6.571h-3.718V12.87h3.718v1.686s1.118-2.069,3.775-2.069,4.556,1.621,4.556,4.975v7.926Z" fill-rule="evenodd"></path>
                      </svg>
                    </a>
                  </nav>
